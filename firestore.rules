rules_version = '2';

// Firestore Security Rules for Baseet (Brainly Life).
// Owner: M1. Each member adds the validation of their own collections here
// (send it in your PR; M1 reviews).
//
// The idea:
//   - Everything lives under users/{uid}. Only that user can touch it.
//   - The main collections are VALIDATED: the shape of every write is
//     checked, so a broken or hacked app cannot save bad data.
//   - aiUsage is written only by Cloud Functions (the Admin SDK skips the
//     rules), never by the app.
//
// IMPORTANT: if several `match` blocks fit the same document, access is
// allowed when ANY of them allows it. So the catch-all at the bottom must
// list the validated collections, or it would skip their checks.
//
// Deploy:  firebase deploy --only firestore
// Test:    firebase emulators:start   (then run the app with USE_EMULATOR)

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isTextOrNull(value, max) {
      return value == null || isText(value, 0, max);
    }

    function isTimestampOrNull(value) {
      return value == null || value is timestamp;
    }

    // createdAt can never change after the document is created.
    function keepsCreatedAt() {
      return incoming().createdAt == resource.data.createdAt;
    }

    // ---------- users/{uid} (M1) ----------
    // Written by AuthRemoteDataSource. createdAt and updatedAt are
    // FieldValue.serverTimestamp(), so they must equal request.time.

    function isValidSettings(s) {
      return s is map
        && s.keys().hasOnly([
          'dailyStudyHours', 'preferredStudyTime', 'weekStartDay',
          'timezone', 'themeMode', 'aiEnabled'
        ])
        && s.dailyStudyHours is number
        && s.dailyStudyHours >= 0 && s.dailyStudyHours <= 24
        && s.preferredStudyTime in ['morning', 'afternoon', 'evening', 'night']
        && s.weekStartDay is int
        && s.weekStartDay >= 1 && s.weekStartDay <= 7
        && isText(s.timezone, 1, 64)
        && s.themeMode in ['system', 'light', 'dark']
        && s.aiEnabled is bool;
    }

    function isValidUser() {
      let d = incoming();
      return d.keys().hasOnly([
          'displayName', 'email', 'photoUrl', 'avatarId', 'settings',
          'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll(['displayName', 'email', 'settings', 'createdAt'])
        && isText(d.displayName, 0, 60)
        && isText(d.email, 0, 254)
        && isTextOrNull(d.get('photoUrl', null), 2048)
        // One of the avatar ids in profile_avatars.dart (or absent).
        && isTextOrNull(d.get('avatarId', null), 32)
        && isValidSettings(d.settings)
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidUser()
        && incoming().createdAt == request.time;
      allow update: if isOwner(uid) && isValidUser() && keepsCreatedAt();
    }

    // ---------- users/{uid}/tasks/{taskId} (M3) ----------
    // Written by Task.toFirestore(). Dates are client Timestamps.

    function isValidTask() {
      let d = incoming();
      return d.keys().hasOnly([
          'title', 'description', 'priority', 'categoryId', 'dueAt',
          'status', 'completedAt', 'subtasks', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll([
          'title', 'priority', 'status', 'subtasks', 'createdAt', 'updatedAt'
        ])
        && isText(d.title, 1, 100)
        && isTextOrNull(d.get('description', null), 1000)
        && d.priority in ['low', 'medium', 'high']
        && d.status in ['todo', 'done']
        && d.subtasks is list && d.subtasks.size() <= 20
        && isTextOrNull(d.get('categoryId', null), 128)
        && isTimestampOrNull(d.get('dueAt', null))
        && isTimestampOrNull(d.get('completedAt', null))
        && d.createdAt is timestamp
        && d.updatedAt is timestamp
        // A done task has completedAt, an open one does not. The
        // "completed in the last 30 days" query depends on this.
        && ((d.status == 'done') == (d.get('completedAt', null) != null));
    }

    match /users/{uid}/tasks/{taskId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && isValidTask();
      allow update: if isOwner(uid) && isValidTask() && keepsCreatedAt();
    }

    // ---------- users/{uid}/taskCategories/{categoryId} (M3) ----------

    function isValidCategory() {
      let d = incoming();
      return d.keys().hasOnly(['name', 'colorValue'])
        && d.keys().hasAll(['name', 'colorValue'])
        && isText(d.name, 1, 30)
        && d.colorValue is int;
    }

    match /users/{uid}/taskCategories/{categoryId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidCategory();
    }

    // ---------- users/{uid}/aiUsage/{day} (M1, Cloud Functions) ----------
    // The app may read it (to show "x requests left"), never write it.

    match /users/{uid}/aiUsage/{day} {
      allow read: if isOwner(uid);
      // Only for "Delete account" (the app deletes everything itself).
      allow delete: if isOwner(uid);
      allow create, update: if false;
    }

    // ---------- users/{uid}/weeklyReports/{weekKey} (M5) ----------
    // The AI report of a finished week. Without Cloud Functions the app
    // (GeminiAiClient) saves it once; it is never edited.

    function isValidWeeklyReport(weekKey) {
      let d = incoming();
      return d.keys().hasOnly([
          'weekKey', 'stats', 'summary', 'recommendations', 'generatedAt',
          'createdAt', 'updatedAt', 'promptVersion'
        ])
        && d.keys().hasAll(['weekKey', 'stats', 'summary', 'recommendations'])
        && d.weekKey == weekKey
        && weekKey.matches('^20[0-9]{2}-W[0-9]{2}$')
        && d.stats is map
        && d.stats.size() <= 20
        && isText(d.summary, 1, 1200)
        && d.recommendations is list
        && d.recommendations.size() == 3
        && isTimestampOrNull(d.get('generatedAt', null))
        && isTimestampOrNull(d.get('createdAt', null))
        && isTimestampOrNull(d.get('updatedAt', null))
        && (d.get('promptVersion', 1) is int);
    }

    match /users/{uid}/weeklyReports/{weekKey} {
      allow read: if isOwner(uid);
      // Also for "Delete account" (the app deletes everything itself).
      allow delete: if isOwner(uid);
      allow create: if isOwner(uid) && isValidWeeklyReport(weekKey);
      allow update: if false;
    }

    // ---------- users/{uid}/habits/{habitId} (M4) ----------
    // Written by Habit.toFirestore(). Dates are client Timestamps; day-level
    // values are dateKeys 'yyyy-MM-dd'.

    function isDateKey(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isCount(value) {
      return value is int && value >= 0;
    }

    function isValidHabit() {
      let d = incoming();
      return d.keys().hasOnly([
          'name', 'icon', 'colorValue', 'frequencyType', 'weekdays',
          'timesPerWeek', 'startDate', 'archived', 'currentStreak',
          'bestStreak', 'lastCompletedDate', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll([
          'name', 'frequencyType', 'startDate', 'archived',
          'createdAt', 'updatedAt'
        ])
        && isText(d.name, 1, 50)
        && isTextOrNull(d.get('icon', null), 40)
        && (d.get('colorValue', null) == null || d.colorValue is int)
        && d.frequencyType in ['daily', 'weekdays', 'timesPerWeek']
        && (d.get('weekdays', null) == null
            || (d.weekdays is list && d.weekdays.size() <= 7))
        && (d.get('timesPerWeek', null) == null
            || (d.timesPerWeek is int
                && d.timesPerWeek >= 1 && d.timesPerWeek <= 7))
        && isDateKey(d.startDate)
        && d.archived is bool
        && isCount(d.get('currentStreak', 0))
        && isCount(d.get('bestStreak', 0))
        && (d.get('lastCompletedDate', null) == null
            || isDateKey(d.lastCompletedDate))
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    match /users/{uid}/habits/{habitId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && isValidHabit();
      allow update: if isOwner(uid) && isValidHabit() && keepsCreatedAt();
    }

    // ---------- users/{uid}/habitLogs/{logId} (M4) ----------
    // One document per habit per done day. The id is '<habitId>_<date>',
    // so the same day can never be counted twice.

    function isValidHabitLog(logId) {
      let d = incoming();
      return d.keys().hasOnly(['habitId', 'date', 'completedAt'])
        && d.keys().hasAll(['habitId', 'date', 'completedAt'])
        && isText(d.habitId, 1, 128)
        && isDateKey(d.date)
        && logId == d.habitId + '_' + d.date
        && d.completedAt is timestamp;
    }

    match /users/{uid}/habitLogs/{logId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidHabitLog(logId);
    }

    // ---------- users/{uid}/focusSessions/{sessionId} (M4) ----------
    // Written by FocusSession.toFirestore() when a timer ends.

    function isValidFocusSession() {
      let d = incoming();
      return d.keys().hasOnly([
          'type', 'startedAt', 'endedAt', 'plannedMinutes', 'actualMinutes',
          'completed', 'dateKey', 'taskId', 'studySessionId',
          'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll([
          'type', 'startedAt', 'endedAt', 'plannedMinutes', 'actualMinutes',
          'completed', 'dateKey', 'createdAt', 'updatedAt'
        ])
        && d.type in ['focus', 'shortBreak', 'longBreak']
        && d.startedAt is timestamp
        && d.endedAt is timestamp
        && d.plannedMinutes is int
        && d.plannedMinutes >= 0 && d.plannedMinutes <= 480
        && d.actualMinutes is int
        && d.actualMinutes >= 0 && d.actualMinutes <= 240
        && d.completed is bool
        && isDateKey(d.dateKey)
        && isTextOrNull(d.get('taskId', null), 128)
        && isTextOrNull(d.get('studySessionId', null), 128)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    match /users/{uid}/focusSessions/{sessionId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && isValidFocusSession();
      allow update: if isOwner(uid) && isValidFocusSession()
        && keepsCreatedAt();
    }

    // ---------- users/{uid}/preferences/{docId} (M4: 'focus') ----------
    // The timer settings live in preferences/focus. Other preference
    // documents stay owner-only without shape checks.

    function isMinutes(value, max) {
      return value is int && value >= 1 && value <= max;
    }

    function isValidFocusSettings() {
      let d = incoming();
      return d.keys().hasOnly([
          'focusMinutes', 'shortBreakMinutes', 'longBreakMinutes',
          'sessionsBeforeLong', 'autoStart', 'sound', 'vibration',
          'keepScreenOn'
        ])
        && isMinutes(d.get('focusMinutes', 25), 240)
        && isMinutes(d.get('shortBreakMinutes', 5), 120)
        && isMinutes(d.get('longBreakMinutes', 15), 120)
        && isMinutes(d.get('sessionsBeforeLong', 4), 20)
        && d.get('autoStart', false) is bool
        && d.get('sound', true) is bool
        && d.get('vibration', true) is bool
        && d.get('keepScreenOn', false) is bool;
    }

    match /users/{uid}/preferences/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && (docId != 'focus' || isValidFocusSettings());
    }

    // ---------- users/{uid}/aiConversations (M5) ----------
    // Written by ChatRemoteDataSource. The conversation document keeps the
    // title and dates; each message is in its messages subcollection.
    // Timestamps are FieldValue.serverTimestamp() (= request.time), except
    // clientCreatedAt. Messages are never edited, only created or deleted
    // (clear conversation / delete account).
    //
    // "At most 50 conversations": rules cannot count documents. The app
    // keeps ONE conversation ('assistant'), and the id format below stops
    // random ids; the limit is enforced by the app.

    function isValidConversation() {
      let d = incoming();
      return d.keys().hasOnly([
          'title', 'lastMessageAt', 'createdAt', 'updatedAt'
        ])
        && isText(d.get('title', 'Brainly AI'), 1, 100)
        && isTimestampOrNull(d.get('lastMessageAt', null))
        && isTimestampOrNull(d.get('createdAt', null))
        && isTimestampOrNull(d.get('updatedAt', null));
    }

    function isValidMessage() {
      let d = incoming();
      return d.keys().hasOnly([
          'role', 'text', 'actions', 'createdAt', 'updatedAt',
          'clientCreatedAt'
        ])
        && d.keys().hasAll(['role', 'text', 'createdAt'])
        && d.role in ['user', 'assistant']
        && isText(d.text, 1, 4000)
        && (d.get('actions', []) is list && d.get('actions', []).size() <= 4)
        && d.createdAt == request.time
        && isTimestampOrNull(d.get('updatedAt', null))
        && isTimestampOrNull(d.get('clientCreatedAt', null));
    }

    match /users/{uid}/aiConversations/{conversationId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && conversationId.matches('^[A-Za-z0-9_-]{1,64}$')
        && isValidConversation();

      match /messages/{messageId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidMessage();
        allow update: if false;
      }
    }

    // ---------- every other collection of the user ----------
    // Owner only, no shape checks yet. When you validate your collection,
    // add a block above AND add its name to this list.

    match /users/{uid}/{collection}/{document=**} {
      allow read, write: if isOwner(uid)
        && !(collection in [
          'tasks', 'taskCategories', 'aiUsage', 'weeklyReports',
          'habits', 'habitLogs', 'focusSessions', 'preferences',
          'aiConversations'
        ]);
    }
  }
}
